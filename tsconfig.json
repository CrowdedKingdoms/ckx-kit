{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "types": ["node", "jest"]
  },
  "include": ["cli/src/**/*", "checks/src/**/*"]
}
